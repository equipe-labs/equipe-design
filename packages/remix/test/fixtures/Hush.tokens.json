    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Hanken Grotesk",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Hanken Grotesk",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "-0.01em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "11px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "19px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "23px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "28px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "33px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "40px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000066",
              "offsetX": "0px",
              "offsetY": "4px",
              "blur": "14px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "140ms"
      },
      "base": {
        "$type": "duration",
        "$value": "240ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Hush",
      "genre": "미니멀",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
}