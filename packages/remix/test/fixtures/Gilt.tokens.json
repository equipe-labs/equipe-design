    "7": {
      "$type": "dimension",
      "$value": "64px"
    },
    "8": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "1px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "2px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Cormorant Garamond",
          "Pretendard",
          "Noto Sans KR",
          "serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Jost",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "0.02em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "9px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "21px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "28px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "38px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "51px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "67px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000000",
              "offsetX": "0px",
              "offsetY": "0px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "200ms"
      },
      "base": {
        "$type": "duration",
        "$value": "360ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Gilt",
      "genre": "럭셔리",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
}