  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "2px"
    },
    "2": {
      "$type": "dimension",
      "$value": "4px"
    },
    "3": {
      "$type": "dimension",
      "$value": "8px"
    },
    "4": {
      "$type": "dimension",
      "$value": "12px"
    },
    "5": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "7": {
      "$type": "dimension",
      "$value": "32px"
    },
    "8": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "2px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "4px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "Pretendard",
          "Noto Sans KR",
          "monospace"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "Pretendard",
          "Noto Sans KR",
          "monospace"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "0em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "15px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "17px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "19px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "21px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "24px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "27px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000000",
              "offsetX": "0px",
              "offsetY": "0px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "0ms"
      },
      "base": {
        "$type": "duration",
        "$value": "80ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "120ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Pewter",
      "genre": "모노",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
}