  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Archivo Black",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Space Grotesk",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 400
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "9px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "21px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "28px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "38px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "51px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "67px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#000000",
          "offsetX": "4px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#ffffff",
              "offsetX": "4px",
              "offsetY": "4px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "0ms"
      },
      "base": {
        "$type": "duration",
        "$value": "80ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "120ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Cornice",
      "genre": "브루탈",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
