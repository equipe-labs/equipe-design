  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "2px"
    },
    "2": {
      "$type": "dimension",
      "$value": "4px"
    },
    "3": {
      "$type": "dimension",
      "$value": "8px"
    },
    "4": {
      "$type": "dimension",
      "$value": "12px"
    },
    "5": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "7": {
      "$type": "dimension",
      "$value": "32px"
    },
    "8": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Zilla Slab",
          "Pretendard",
          "Noto Sans KR",
          "serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Mukta",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "0em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "10px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "20px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "25px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "31px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "39px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "49px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000066",
              "offsetX": "0px",
              "offsetY": "4px",
              "blur": "14px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "200ms"
      },
      "base": {
        "$type": "duration",
        "$value": "360ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Umber",
      "genre": "흙빛",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
}