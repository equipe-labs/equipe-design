  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Public Sans",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Public Sans",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "0em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "10px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "15px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "22px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "26px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "31px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "37px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000066",
              "offsetX": "0px",
              "offsetY": "4px",
              "blur": "14px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "140ms"
      },
      "base": {
        "$type": "duration",
        "$value": "240ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Abacus",
      "genre": "차분한 금융",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
