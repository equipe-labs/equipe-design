  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "160ms"
      },
      "base": {
        "$type": "duration",
        "$value": "280ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "480ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Bloop",
