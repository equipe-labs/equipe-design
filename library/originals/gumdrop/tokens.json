  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Baloo 2",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Nunito",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 800
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "0em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "10px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "17px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "23px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "30px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "40px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "54px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "72px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#6d28d9",
          "offsetX": "4px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#b794ff",
              "offsetX": "4px",
              "offsetY": "4px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "160ms"
      },
      "base": {
        "$type": "duration",
        "$value": "280ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "480ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Gumdrop",
      "genre": "어린이",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
