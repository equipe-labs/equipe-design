  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "16px"
    },
    "4": {
      "$type": "dimension",
      "$value": "24px"
    },
    "5": {
      "$type": "dimension",
      "$value": "32px"
    },
    "6": {
      "$type": "dimension",
      "$value": "48px"
    },
    "7": {
      "$type": "dimension",
      "$value": "64px"
    },
    "8": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Bodoni Moda",
          "Pretendard",
          "Noto Sans KR",
          "serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Source Sans 3",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "10px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "17px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "23px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "30px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "40px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "54px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "72px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000000",
              "offsetX": "0px",
              "offsetY": "0px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "200ms"
      },
      "base": {
        "$type": "duration",
        "$value": "360ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Verso",
      "genre": "에디토리얼",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
}