  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000066",
              "offsetX": "0px",
              "offsetY": "4px",
              "blur": "14px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "140ms"
      },
      "base": {
        "$type": "duration",
        "$value": "240ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Guild",
      "genre": "기업용",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
