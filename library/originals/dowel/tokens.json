      "$type": "shadow",
      "$value": [
        {
          "color": "#1e211a",
          "offsetX": "4px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#e5e8d6",
              "offsetX": "4px",
              "offsetY": "4px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
