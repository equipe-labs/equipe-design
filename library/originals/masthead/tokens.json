      },
      "raised": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "text": {
        "$type": "color",
        "$value": "#111111"
      },
      "muted-text": {
        "$type": "color",
        "$value": "#6b6b6b"
      },
      "primary": {
        "$type": "color",
        "$value": "#0b2a5b"
      },
      "on-primary": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "secondary": {
        "$type": "color",
        "$value": "#efefef"
      },
      "accent": {
        "$type": "color",
        "$value": "#b3001b"
      },
      "border": {
        "$type": "color",
        "$value": "#cbcbcb"
      },
      "border-strong": {
        "$type": "color",
