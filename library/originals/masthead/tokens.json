      },
      "ring": {
        "$type": "color",
        "$value": "#0b2a5b"
      },
      "destructive": {
        "$type": "color",
        "$value": "#c62828"
      },
      "success": {
        "$type": "color",
        "$value": "#1b7a43"
      },
      "warning": {
