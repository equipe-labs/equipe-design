        "$value": "#8f5b00"
      }
    },
    "dark": {
      "background": {
        "$type": "color",
        "$value": "#121212"
      },
      "surface": {
        "$type": "color",
        "$value": "#1e1e1e"
      },
      "raised": {
        "$type": "color",
        "$value": "#2a2a2a"
      },
      "text": {
        "$type": "color",
        "$value": "#eeeeee"
      },
      "muted-text": {
        "$type": "color",
        "$value": "#9a9a9a"
      },
      "primary": {
        "$type": "color",
        "$value": "#8fb3ff"
      },
      "on-primary": {
        "$type": "color",
        "$value": "#000000"
      },
      "secondary": {
        "$type": "color",
        "$value": "#262626"
      },
      "accent": {
        "$type": "color",
        "$value": "#ff6b6b"
      },
      "border": {
        "$type": "color",
        "$value": "#424242"
      },
      "border-strong": {
        "$type": "color",
        "$value": "#8b8b8b"
      },
      "ring": {
        "$type": "color",
        "$value": "#8fb3ff"
      },
      "destructive": {
        "$type": "color",
        "$value": "#ff7b72"
      },
      "success": {
        "$type": "color",
        "$value": "#4cc38a"
      },
      "warning": {
        "$type": "color",
        "$value": "#e8b44a"
      }
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "2px"
    },
    "2": {
      "$type": "dimension",
      "$value": "4px"
    },
    "3": {
      "$type": "dimension",
      "$value": "8px"
    },
    "4": {
      "$type": "dimension",
      "$value": "12px"
    },
    "5": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "7": {
      "$type": "dimension",
      "$value": "32px"
    },
    "8": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Old Standard TT",
          "Pretendard",
          "Noto Sans KR",
          "serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Roboto Condensed",
          "Pretendard",
          "Noto Sans KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "letterSpacing": {
      "heading": {
        "$type": "dimension",
        "$value": "0em"
      },
      "body": {
        "$type": "dimension",
        "$value": "0em"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "10px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "15px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "22px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "26px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "31px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "37px"
      }
    }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#cbcbcb",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#424242",
              "offsetX": "0px",
              "offsetY": "1px",
              "blur": "0px",
              "spread": "0px"
            }
          ]
        }
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "0ms"
      },
      "base": {
        "$type": "duration",
        "$value": "80ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "120ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    }
  },
  "$extensions": {
    "equipe.library": {
      "name": "Masthead",
      "genre": "신문",
      "origin": "original",
      "fontLicense": "OFL-1.1"
    }
  }
}