      "base": {
        "$type": "duration",
        "$value": "160ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "240ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
