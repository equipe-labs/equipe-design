    },
    "3": {
      "$type": "dimension",
      "$value": "16px"
    },
    "4": {
      "$type": "dimension",
      "$value": "24px"
    },
    "5": {
      "$type": "dimension",
      "$value": "32px"
    },
    "6": {
      "$type": "dimension",
      "$value": "48px"
