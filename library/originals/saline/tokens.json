          "blur": "14px",
          "spread": "0px"
        }
      ],
      "$extensions": {
        "mode": {
          "dark": [
            {
              "color": "#00000066",
              "offsetX": "0px",
              "offsetY": "4px",
              "blur": "14px",
              "spread": "0px"
            }
          ]
        }
      }
    }
